extends SceneTree
const Combat = preload("res://scripts/combat/trident_combat.gd")
var failed := 0
var checks := 0

func check(condition: bool, label: String) -> void:
	checks += 1
	if not condition:
		failed += 1
		printerr("FAIL: ", label)

func _initialize() -> void:
	for landed in [true,false]:
		var early = Combat.new()
		early.set_action("reply")
		early.advance(0.08)
		check(not early.request("flash") and early.buffered=="flash","early flash input retained")
		early.advance(0.18)
		if landed: early.confirm_hit()
		early.advance(0.15)
		check(early.action==("flash" if landed else "reply"),"buffered flash requires actual reply contact")
		check(early.shadow_lifetimes.is_empty(),"starting or missing flash grants no shadow")
	var c = Combat.new()
	check(c.request("light"), "light draws weapon")
	check(c.drawn and not c.request("light"), "no self cancel")
	c.advance(0.40)
	check(c.request("heavy"), "light into heavy")
	c.advance(0.60)
	check(c.request("light"), "heavy into light")
	c.advance(1)
	check(c.request("light"), "new idle chain can repeat light")
	c.set_action("idle")
	check(not c.request("spin"), "no free resource combo")
	c.request("guard")
	c.advance(0.15)
	check(c.receive_damage(40) == "guarded" and c.health == 240, "front guard")
	check(c.request("reply"), "guard reply")
	check(c.receive_damage(40) == "immune", "reply immunity")
	c.confirm_hit()
	c.advance(0.42)
	check(c.request("flash"), "earned reply permits flash")
	c.confirm_hit()
	c.confirm_hit()
	check(c.shadow_lifetimes.size() == 1, "one flash yields one stack per action")
	c.set_action("idle")
	for i in 7:
		c.set_action("flash")
		c.confirm_hit()
	check(c.shadow_lifetimes.size() == 5, "cap at five")
	c.set_action("idle")
	check(c.request("spin") and c.shadow_lifetimes.size() == 4, "spend one")
	var health: float = c.health
	check(c.receive_damage(20) == "armored" and c.health == health - 20 and c.action == "spin", "armor is not immunity")
	c.advance(1.1)
	check(c.request("spin") and c.shadow_lifetimes.size() == 3, "repeat special costs again")
	c.set_action("idle")
	c.request("fourfold")
	c.receive_damage(10)
	check(c.action == "hurt", "fourfold is interruptible")
	c.set_action("idle")
	c.drawn = true
	c.request("plant")
	c.advance(0.65)
	check(c.action == "wait", "plant enters wait")
	var stacks: int = c.shadow_lifetimes.size()
	c.request("counter_window")
	c.advance(0.49)
	check(c.receive_damage(100) == "counter" and c.action == "finisher", "counter in half-second")
	check(c.shadow_lifetimes.size() == stacks, "counter preserves shadows")
	c.set_action("counter_window")
	c.advance(0.5)
	check(c.action == "idle" and c.receive_damage(10) == "hurt", "counter expires at half-second")
	c.set_action("wait")
	c.advance(30)
	check(c.action == "idle", "wait maximum thirty seconds")
	c.shadow_lifetimes.assign([0.01, 180.0])
	c.set_action("idle")
	c.advance(0.02)
	check(c.shadow_lifetimes.size() == 1, "independent stack expiry")
	c.advance(180)
	check(c.shadow_lifetimes.is_empty(), "180-second expiry")
	var hits: Array[int] = []
	c.strike.connect(func(beat: int): hits.append(beat))
	c.shadow_lifetimes.append(180)
	c.request("fourfold")
	c.advance(1.24)
	check(hits == [0,1,2,3], "four distinct beats even across large delta")
	c.health = 240
	c.set_action("light")
	check(c.receive_damage(9,false,true,false)=="ongoing" and c.action=="light" and c.health==231,"poison drains health without repeated stagger lock")
	c.receive_damage(300,false,true,false)
	check(c.health==0 and c.action=="hurt","periodic damage remains lethal")
	print("COMBAT_CHECKS: ", checks, " FAILURES: ", failed)
	quit(1 if failed else 0)
